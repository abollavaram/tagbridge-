# Postgres (Neon in production). Leave unset locally to use the in-process
# PGlite database that `pnpm db:setup` creates — the app, the tests and the
# e2e run all work without provisioning anything.
# DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# Required in production. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Optional sign-in providers. Each is offered only when its variables are set.
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
# EMAIL_FROM="TagBridge <no-reply@example.com>"

# Seeded demo accounts sign in without a secret. Refused when NODE_ENV is
# production unless ALLOW_DEV_LOGIN_IN_PROD is also set, which only the public
# demo deployment does.
AUTH_DEV_LOGIN="true"
# ALLOW_DEV_LOGIN_IN_PROD="false"

# Wired up in later phases; reported by /api/health either way.
# ANTHROPIC_API_KEY=""
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

LOG_LEVEL="info"
