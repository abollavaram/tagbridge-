# Postgres. Leave unset to use the in-process database restored from the
# build-time snapshot — the app, the tests and the e2e run all work without
# provisioning anything, at the cost of writes not outliving the instance.
# DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# Generate with: openssl rand -base64 32
# Without it, a fresh secret is generated at build time and sessions do not
# survive a redeploy.
# AUTH_SECRET=""

# Optional sign-in providers. Each is offered only when its variables are set.
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
# EMAIL_FROM="TagBridge <no-reply@example.com>"

# The three seeded demo accounts sign in directly. They are offered by default
# when no other provider is configured; set this to "false" to withdraw them, or
# "true" to keep them alongside a real provider.
# AUTH_DEV_LOGIN="true"

# Wired up in later phases; reported by /api/health either way.
# ANTHROPIC_API_KEY=""
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

LOG_LEVEL="info"
